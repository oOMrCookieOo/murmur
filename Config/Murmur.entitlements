<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Sandbox is intentionally OFF.

	  Murmur needs the Accessibility API (AXUIElement) and CGEvent posting to
	  paste into other applications. Sandboxed apps are denied both, with no
	  entitlement that grants them. This is the same trade-off every text
	  -injection utility on macOS makes (Plainsay, Raycast, TextExpander...).

	  Consequence: the app cannot be distributed on the Mac App Store.
	  For personal use this is irrelevant.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Required under the Hardened Runtime to open the microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
